{
	"name": "yuku-tsrx",
	"version": "0.1.5",
	"description": "TSRX parser, analyzer, and code generator: a compile-time dialect on Yuku, with a JavaScript API on a native addon",
	"keywords": [
		"analyzer",
		"ast",
		"codegen",
		"estree",
		"parser",
		"tsrx",
		"yuku"
	],
	"homepage": "https://compiled.run/yuku-tsrx",
	"bugs": {
		"url": "https://github.com/compiled-run/yuku-tsrx/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compiled-run/yuku-tsrx.git"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"binding.js",
		"decode.js",
		"decode-analyzer.js",
		"diagnostic-spans.js",
		"encode.js",
		"walk.js"
	],
	"type": "module",
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"optionalDependencies": {
		"@yuku-tsrx/binding-darwin-arm64": "0.1.5",
		"@yuku-tsrx/binding-linux-x64-gnu": "0.1.5"
	},
	"engines": {
		"node": ">=22"
	}
}
