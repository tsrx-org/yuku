{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide/introduction",
      "destination": "/guide/quick-start",
      "permanent": true
    },
    {
      "source": "/guide/introduction.md",
      "destination": "/guide/quick-start.md",
      "permanent": true
    },
    {
      "source": "/guide/getting-started",
      "destination": "/guide/quick-start",
      "permanent": true
    },
    {
      "source": "/guide/getting-started.md",
      "destination": "/guide/quick-start.md",
      "permanent": true
    },
    {
      "source": "/guide/oxc-or-yuku",
      "destination": "/guide/quick-start",
      "permanent": true
    },
    {
      "source": "/guide/oxc-or-yuku.md",
      "destination": "/guide/quick-start.md",
      "permanent": true
    },
    {
      "source": "/guide/tsrx-syntax",
      "destination": "/guide/parse",
      "permanent": true
    },
    {
      "source": "/guide/tsrx-syntax.md",
      "destination": "/guide/parse.md",
      "permanent": true
    },
    {
      "source": "/guide/tsrx",
      "destination": "/guide/parse",
      "permanent": true
    },
    {
      "source": "/guide/tsrx.md",
      "destination": "/guide/parse.md",
      "permanent": true
    },
    {
      "source": "/guide/parser",
      "destination": "/guide/parse",
      "permanent": true
    },
    {
      "source": "/guide/parser.md",
      "destination": "/guide/parse.md",
      "permanent": true
